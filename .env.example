# ---------------------------------------------------------------------------
# SysRev Meta-Analysis Agent — environment configuration
# Copy to `.env` and fill in. Never commit the populated `.env` file.
# ---------------------------------------------------------------------------

# --- Persistence -----------------------------------------------------------
SYSREV_DATABASE_URL=sqlite:///./data/sysrev.db
SYSREV_DATA_DIR=./data

# --- NCBI Entrez (PubMed E-utilities) --------------------------------------
# NCBI requires `tool` and `email` parameters; an API key raises the limit
# from 3 to 10 requests/second (https://www.ncbi.nlm.nih.gov/books/NBK25497/).
SYSREV_NCBI_EMAIL=you@institution.org
SYSREV_NCBI_TOOL=sysrev-meta-analysis
SYSREV_NCBI_API_KEY=

# --- Europe PMC ------------------------------------------------------------
SYSREV_EUROPEPMC_REQUESTS_PER_SECOND=5

# --- OpenAlex --------------------------------------------------------------
# A contact address routes requests to the OpenAlex "polite pool". If your
# OpenAlex account issues an API key, set it here (check current OpenAlex docs).
SYSREV_OPENALEX_MAILTO=you@institution.org
SYSREV_OPENALEX_API_KEY=
SYSREV_OPENALEX_REQUESTS_PER_SECOND=8

# --- Unpaywall (Open Access PDF resolution) --------------------------------
# Unpaywall requires an `email` query parameter on every request.
SYSREV_UNPAYWALL_EMAIL=you@institution.org
SYSREV_UNPAYWALL_REQUESTS_PER_SECOND=5

# --- Crossref (DOI verification for the Auditor) ---------------------------
SYSREV_CROSSREF_MAILTO=you@institution.org
SYSREV_CROSSREF_REQUESTS_PER_SECOND=5

# --- HTTP behaviour --------------------------------------------------------
SYSREV_HTTP_TIMEOUT_SECONDS=30
SYSREV_HTTP_MAX_RETRIES=5

# --- Deduplication / cohort-overlap thresholds ------------------------------
SYSREV_DEDUP_TITLE_THRESHOLD=95
SYSREV_COHORT_OVERLAP_FLAG_THRESHOLD=0.45

# --- Reviewer tokens -------------------------------------------------------
# Never put reviewer gate-approval tokens in this file: they are issued once by
# `python -m src.api_server.reviewer_cli enroll` and must stay with the human.

# --- LLM provider API keys (Session 4) -------------------------------------
# Used ONLY for language tasks (screening proposals, extraction proposals, advisory
# verification, risk-of-bias drafts) — never for retrieval, statistics or approvals.
# Prefer entering keys in the UI (memory only) or the OS credential store; if you
# put them here, keep this file out of Git (it is in .gitignore).
# Billing: keys bill the API account that issued them (Anthropic Console / OpenAI
# Platform). Claude subscription / Claude Code development credits and ChatGPT
# subscriptions do NOT pay for API calls.
# Models and effort are chosen per task in the UI, not here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: let the UI talk to a separately started API server instead of in-process.
# SYSREV_API_URL=http://127.0.0.1:8000
